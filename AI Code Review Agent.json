    {
      "parameters": {
        "jsCode": "// Build the target prompt from the PR diff\nconst diff = $input.first().json.data || $input.first().json.body || '';\nconst prTitle = $('PR Trigger').first().json.pull_request.title;\nconst prNumber = $('PR Trigger').first().json.pull_request.number;\n\nconst prompt = `You are reviewing Pull Request #${prNumber}: \"${prTitle}\".\n\nHere is the diff of the changes:\n\n${diff}\n\nReview this diff for code quality, bugs, security issues, and adherence to best practices. Provide clear, actionable feedback.`;\n\nreturn [{ json: { prompt, prNumber } }];"
      },
      "id": "0dc4879b-c6ba-4c78-b745-9a17af684df8",
